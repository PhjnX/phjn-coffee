# Copy to .env.local for local development; on Vercel add the same names under
# Project → Settings → Environment Variables.

# ── Admin ─────────────────────────────────────────────────────────────────
# Password for /admin. Without it, `npm run dev` uses "phjn-admin"; production refuses to sign in.
ADMIN_PASSWORD=
# A long random string used to sign the admin cookie (e.g. `openssl rand -base64 32`).
ADMIN_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────
# The public address, e.g. https://phjn.vercel.app. Must be set BEFORE building:
# it goes into the sitemap, link previews and the table QR codes.
NEXT_PUBLIC_SITE_URL=

# ── Supabase (database + photo storage) ───────────────────────────────────
# Supabase → Project Settings → API. Leave empty to keep data in data/db.json (local only).
SUPABASE_URL=
# The "service_role" secret key. Server-only: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
